# FARHADIO Environment Variables

# App
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="FARHADIO Luxury Timepieces"

# Database
# Connect to MongoDB Atlas or local MongoDB instance
# If left blank or connection fails, the app seamlessly uses the embedded luxury store dataset
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/farhadio?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Payments (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
